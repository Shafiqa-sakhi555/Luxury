# Database (PostgreSQL)
# Option A — local Prisma Postgres (recommended for development):
#   Terminal 1: npm run db:dev   (leave running)
#   Then paste the DATABASE_URL printed by that command here.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"

# Option B — Neon, Supabase, or any hosted PostgreSQL:
# DATABASE_URL="postgresql://user:pass@host:5432/jalals?sslmode=require"

# Auth.js
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="generate-a-32-byte-base64-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Cloudinary (optional until media upload is configured)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Supabase (production catalog + storage — add to .env.local)
NEXT_PUBLIC_SUPABASE_URL="https://oeiqranaxdpfzypyokps.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only — never expose to the browser:
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Direct Postgres URL for migrations (Dashboard → Database → Connection string):
# SUPABASE_DB_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Email (optional until transactional email is configured)
RESEND_API_KEY=""
EMAIL_FROM="orders@jalalsgroup.com"
