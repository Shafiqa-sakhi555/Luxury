# Supabase — get values from Dashboard → Project Settings → API / Database
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="..."  # legacy JWT anon key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."  # newer Supabase key (either works in browser)
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
# SUPABASE_DB_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# # Cloudinary (optional — product image uploads)
