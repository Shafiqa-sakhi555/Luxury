// JalalsGroup e-commerce — Prisma schema
// Money: integer minor units (paisa). SKU unique at DB level.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  passwordHash  String?
  image         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  userRoles          UserRole[]
  customer           Customer?
  auditLogs          AuditLog[]           @relation("AuditActor")
  stockMovements     StockMovement[]
  orderStatusHistory OrderStatusHistory[]
  customerNotes      CustomerNote[]       @relation("NoteAuthor")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  description String?

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Customer {
  id               String   @id @default(cuid())
  userId           String   @unique
  phone            String?
  preferredStoreId String?
  marketingConsent Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredStore Store?         @relation(fields: [preferredStoreId], references: [id])
  addresses      Address[]
  orders         Order[]
  cart           Cart?
  wishlist       Wishlist?
  reviews        Review[]
  quotations     Quotation[]
  notes          CustomerNote[]
  tags           CustomerTag[]
}

model Address {
  id                String  @id @default(cuid())
  customerId        String
  label             String  @default("Home")
  line1             String
  line2             String?
  city              String
  region            String?
  postalCode        String?
  phone             String?
  isDefaultShipping Boolean @default(false)
  isDefaultBilling  Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

enum PublicationStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductType {
  SIMPLE
  VARIANT
  MADE_TO_MEASURE
  CONFIGURABLE
}

enum MediaType {
  IMAGE
  VIDEO
  MODEL_3D
}

model Category {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  description    String?           @db.Text
  heroImage      String?
  parentId       String?
  sortOrder      Int               @default(0)
  status         PublicationStatus @default(ACTIVE)
  seoTitle       String?
  seoDescription String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  parent     Category?             @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[]            @relation("CategoryTree")
  products   Product[]
  attributes AttributeDefinition[]
}

model Brand {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?           @db.Text
  logoUrl     String?
  status      PublicationStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  products Product[]
}

model Collection {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?           @db.Text
  imageUrl    String?
  status      PublicationStatus @default(ACTIVE)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  products ProductCollection[]
}

model Product {
  id                    String            @id @default(cuid())
  name                  String
  slug                  String            @unique
  shortDescription      String?           @db.Text
  description           String?           @db.Text
  categoryId            String
  brandId               String?
  productType           ProductType       @default(VARIANT)
  status                PublicationStatus @default(DRAFT)
  isFeatured            Boolean           @default(false)
  visualizerEligible    Boolean           @default(false)
  customizationEligible Boolean           @default(false)
  externalCisId         String?
  seoTitle              String?
  seoDescription        String?           @db.Text
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  category          Category                   @relation(fields: [categoryId], references: [id])
  brand             Brand?                     @relation(fields: [brandId], references: [id])
  variants          ProductVariant[]
  media             ProductMedia[]
  collections       ProductCollection[]
  relationsFrom     ProductRelation[]          @relation("ProductFrom")
  relationsTo       ProductRelation[]          @relation("ProductTo")
  storeAvailability ProductStoreAvailability[]
  reviews           Review[]
}

model ProductCollection {
  productId    String
  collectionId String

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model ProductVariant {
  id                   String   @id @default(cuid())
  productId            String
  sku                  String   @unique
  name                 String?
  priceMinor           Int
  salePriceMinor       Int?
  barcode              String?
  weightGrams          Int?
  lengthMm             Int?
  widthMm              Int?
  heightMm             Int?
  externalCisVariantId String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  product           Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues   VariantAttributeValue[]
  media             ProductMedia[]
  inventoryBalances InventoryBalance[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  wishlistItems     WishlistItem[]
}

enum AttributeDataType {
  TEXT
  NUMBER
  ENUM
  BOOLEAN
}

model AttributeDefinition {
  id             String            @id @default(cuid())
  categoryId     String
  name           String
  key            String
  dataType       AttributeDataType @default(TEXT)
  unit           String?
  isFilterable   Boolean           @default(false)
  isVariantLevel Boolean           @default(false)
  isRequired     Boolean           @default(false)
  displayOrder   Int               @default(0)

  category      Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options       AttributeOption[]
  variantValues VariantAttributeValue[]

  @@unique([categoryId, key])
}

model AttributeOption {
  id          String @id @default(cuid())
  attributeId String
  value       String
  label       String
  sortOrder   Int    @default(0)

  attribute AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
}

model VariantAttributeValue {
  id          String @id @default(cuid())
  variantId   String
  attributeId String
  value       String

  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([variantId, attributeId])
}

model ProductMedia {
  id        String    @id @default(cuid())
  productId String
  variantId String?
  url       String
  alt       String?
  type      MediaType @default(IMAGE)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

enum ProductRelationType {
  RELATED
  SIMILAR
  BOUGHT_TOGETHER
}

model ProductRelation {
  id            String              @id @default(cuid())
  fromProductId String
  toProductId   String
  type          ProductRelationType

  fromProduct Product @relation("ProductFrom", fields: [fromProductId], references: [id], onDelete: Cascade)
  toProduct   Product @relation("ProductTo", fields: [toProductId], references: [id], onDelete: Cascade)

  @@unique([fromProductId, toProductId, type])
}

enum StoreBrand {
  JALALS_HOME
  PAK_TURK
  JALAL_CARPETS
}

model Store {
  id           String     @id @default(cuid())
  slug         String     @unique
  brand        StoreBrand @default(JALALS_HOME)
  brandLabel   String
  name         String
  city         String
  region       String?
  address      String     @db.Text
  phone        String
  phoneDisplay String?
  hours        String?
  lat          Float?
  lng          Float?
  isFlagship   Boolean    @default(false)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  inventoryBalances  InventoryBalance[]
  storeAvailability  ProductStoreAvailability[]
  orders             Order[]
  preferredCustomers Customer[]
}

model ProductStoreAvailability {
  id        String @id @default(cuid())
  productId String
  storeId   String
  status    String @default("IN_STOCK")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([productId, storeId])
}

enum StockMovementType {
  RECEIVE
  SALE
  RESERVATION
  RELEASE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  DAMAGE
  RETURN
}

model InventoryBalance {
  id           String   @id @default(cuid())
  storeId      String
  variantId    String
  onHand       Int      @default(0)
  reserved     Int      @default(0)
  damaged      Int      @default(0)
  returned     Int      @default(0)
  reorderPoint Int      @default(5)
  updatedAt    DateTime @updatedAt

  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([storeId, variantId])
}

model StockMovement {
  id            String            @id @default(cuid())
  storeId       String
  variantId     String
  type          StockMovementType
  delta         Int
  balanceAfter  Int
  reason        String?
  referenceType String?
  referenceId   String?
  actorId       String?
  createdAt     DateTime          @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([storeId, createdAt])
}

model Cart {
  id         String    @id @default(cuid())
  customerId String?   @unique
  token      String?   @unique
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]
}

model CartItem {
  id                 String @id @default(cuid())
  cartId             String
  variantId          String
  quantity           Int    @default(1)
  customization      Json?
  priceSnapshotMinor Int?
  pricingMode        String @default("INSTANT")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentMethod {
  COD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum FulfilmentType {
  DELIVERY
  BRANCH_PICKUP
}

model Order {
  id             String         @id @default(cuid())
  orderNumber    String         @unique
  customerId     String
  status         OrderStatus    @default(PENDING)
  paymentMethod  PaymentMethod  @default(COD)
  paymentStatus  PaymentStatus  @default(PENDING)
  fulfilmentType FulfilmentType @default(DELIVERY)
  storeId        String?
  subtotalMinor  Int
  discountMinor  Int            @default(0)
  deliveryMinor  Int            @default(0)
  taxMinor       Int            @default(0)
  totalMinor     Int
  shippingName   String?
  shippingLine1  String?
  shippingLine2  String?
  shippingCity   String?
  shippingRegion String?
  shippingPostal String?
  shippingPhone  String?
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  customer      Customer             @relation(fields: [customerId], references: [id])
  store         Store?               @relation(fields: [storeId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  variantId      String?
  productName    String
  variantSku     String
  variantName    String?
  imageUrl       String?
  unitPriceMinor Int
  quantity       Int
  lineTotalMinor Int
  customization  Json?

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?
  reason     String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

model Quotation {
  id         String   @id @default(cuid())
  customerId String
  status     String   @default("PENDING")
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
}

model Wishlist {
  id         String @id @default(cuid())
  customerId String @unique

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    WishlistItem[]
}

model WishlistItem {
  id         String @id @default(cuid())
  wishlistId String
  variantId  String

  wishlist Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([wishlistId, variantId])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  customerId String
  rating     Int
  title      String?
  body       String?  @db.Text
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  authorId   String
  body       String   @db.Text
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   User     @relation("NoteAuthor", fields: [authorId], references: [id])
}

model CustomerTag {
  id         String @id @default(cuid())
  customerId String
  tag        String

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, tag])
}

model ContentPage {
  id             String            @id @default(cuid())
  slug           String            @unique
  title          String
  body           String            @db.Text
  status         PublicationStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model JournalPost {
  id          String            @id @default(cuid())
  slug        String            @unique
  title       String
  excerpt     String?           @db.Text
  body        String            @db.Text
  category    String?
  imageUrl    String?
  status      PublicationStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model ImportRun {
  id          String    @id @default(cuid())
  filename    String
  status      String    @default("PENDING")
  totalRows   Int       @default(0)
  successRows Int       @default(0)
  errorRows   Int       @default(0)
  actorId     String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  errors ImportRunError[]
}

model ImportRunError {
  id          String  @id @default(cuid())
  importRunId String
  rowNumber   Int
  field       String?
  message     String

  importRun ImportRun @relation(fields: [importRunId], references: [id], onDelete: Cascade)
}
